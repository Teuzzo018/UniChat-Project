datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
  PLATFORM_ADMIN
  SUPERADMIN
}

enum ChannelType {
  TEXT
  VOICE
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ServerJoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model University {
  id        String   @id @default(uuid())
  name      String   @unique
  domain    String   @unique
  users     User[]
  servers   Server[]
  createdAt DateTime @default(now())
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  username     String?        @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  role         Role           @default(STUDENT)
  suspendedAt  DateTime?
  totpSecretEncrypted String?
  totpPendingEncrypted String?
  totpPendingExpiresAt DateTime?
  totpEnabledAt DateTime?
  totpLastTimeStep Int?
  mfaFailedAttempts Int @default(0)
  mfaLockedUntil DateTime?
  recoveryCodes MfaRecoveryCode[]

  universityId String?
  university   University?   @relation(fields: [universityId], references: [id])

  sessions     Session[]
  ownedServers Server[]       @relation("ServerOwner")
  servers      ServerMember[]
  messages     Message[]
  privateMessagesSent     PrivateMessage[] @relation("PrivateMessageSender")
  privateMessagesReceived PrivateMessage[] @relation("PrivateMessageRecipient")
  privateCallsStarted PrivateCall[] @relation("PrivateCallCaller")
  privateCallsReceived PrivateCall[] @relation("PrivateCallRecipient")
  friendshipsStarted  Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")
  friendshipRequestsMade Friendship[] @relation("FriendshipRequestedBy")
  blockedUsers BlockedUser[] @relation("BlockedUsers")
  blockedByUsers BlockedUser[] @relation("BlockedByUsers")
  serverJoinRequests ServerJoinRequest[]

  createdAt    DateTime       @default(now())

  @@index([role, suspendedAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())
  secondFactorPending Boolean @default(false)
  secondFactorVerifiedAt DateTime?
}

model MfaRecoveryCode {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

model Server {
  id           String   @id @default(uuid())
  name         String
  description  String?
  inviteCode   String   @unique
  inviteExpiresAt DateTime?
  inviteMaxUses Int?
  inviteUses Int @default(0)
  inviteRevokedAt DateTime?
  isDiscoverable Boolean @default(false)

  universityId String
  university   University @relation(fields: [universityId], references: [id])

  ownerId      String
  owner        User     @relation("ServerOwner", fields: [ownerId], references: [id])

  channels     Channel[]
  members      ServerMember[]
  joinRequests ServerJoinRequest[]

  createdAt    DateTime @default(now())

  @@index([isDiscoverable, universityId, name])
}

model ServerMember {
  id       String @id @default(uuid())
  userId   String
  serverId String
  isAdmin  Boolean @default(false)

  user     User   @relation(fields: [userId], references: [id])
  server   Server @relation(fields: [serverId], references: [id])

  @@unique([userId, serverId])
  @@index([serverId, isAdmin])
}

model Channel {
  id        String      @id @default(uuid())
  name      String
  type      ChannelType @default(TEXT)

  serverId  String
  server    Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)

  messages  Message[]

  createdAt DateTime @default(now())

  @@index([serverId, name])
}

model Message {
  id        String   @id @default(uuid())
  content   String   @default("")
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  deletedAt          DateTime?
  deletedById        String?

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  channelId String
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model PrivateMessage {
  id        String   @id @default(uuid())
  content   String   @default("")
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  deletedAt          DateTime?
  deletedById        String?

  senderId    String
  sender      User     @relation("PrivateMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  recipientId String
  recipient   User     @relation("PrivateMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
}

model PrivateCall {
  id          String   @id
  callerId    String
  recipientId String
  status      String   @default("RINGING")

  caller      User     @relation("PrivateCallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  recipient   User     @relation("PrivateCallRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  startedAt   DateTime @default(now())
  answeredAt  DateTime?
  endedAt     DateTime?

  @@index([callerId, recipientId, startedAt])
  @@index([recipientId, callerId, startedAt])
}

model Friendship {
  id          String   @id @default(uuid())
  requesterId String
  addresseeId String
  requestedById String?
  status      FriendshipStatus @default(ACCEPTED)

  requester   User     @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User     @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  requestedBy User?    @relation("FriendshipRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String

  blocker   User     @relation("BlockedUsers", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockedByUsers", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model ServerJoinRequest {
  id        String   @id @default(uuid())
  userId    String
  serverId  String
  status    ServerJoinRequestStatus @default(PENDING)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serverId])
  @@index([serverId, status])
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  actorId      String
  action       String
  resourceType String
  resourceId   String
  serverId     String?
  outcome      String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([serverId, createdAt])
  @@index([actorId, createdAt])
}
