DATABASE_URL="postgresql://unichat_user:unichat_password@localhost:5433/unichat_db?schema=public"
PORT=5000
CORS_ORIGIN="http://localhost:5173"
SESSION_DURATION_DAYS=7
SALT_ROUNDS=12

# Cambia questo valore in locale/produzione. Se lo cambi, le sessioni esistenti non saranno piu valide.
SESSION_TOKEN_PEPPER="replace-with-a-long-random-secret"

# Codice opzionale per creare un account ADMIN dalla registrazione.
ADMIN_SETUP_CODE="replace-with-admin-code"
