DATABASE_URL="postgresql://unichat_user:unichat_password@127.0.0.1:5433/unichat_db?schema=public"
PORT=5000
CORS_ORIGIN="http://localhost:5173"
SESSION_DURATION_DAYS=7
SALT_ROUNDS=12

# Cambia questo valore in locale/produzione. Se lo cambi, le sessioni esistenti non saranno piu valide.
SESSION_TOKEN_PEPPER=e7866cef0b2ca060ec7391006b7aea2ea15ba5bdfeea7e782348968041e478d5

# Codice opzionale per il bootstrap iniziale del SUPERADMIN.

# Chiave esterna al database per cifrare i segreti TOTP con AES-256-GCM.
# Imposta 64 caratteri esadecimali casuali e conserva il valore stabile tra i riavvii.
# TOTP_ENCRYPTION_KEY="<64-caratteri-esadecimali-casuali>"

# Allegati delle chat: 0 file disabilita gli allegati; il modello supporta 0 o 1 file per messaggio.
MAX_ATTACHMENT_BYTES=26214400
MAX_ATTACHMENT_FILES_PER_MESSAGE=1
MAX_ATTACHMENT_STORAGE_BYTES=1073741824

# Chiamate private uno-a-uno. Elenchi di URL separati da virgole.
# STUN aiuta la scoperta dei candidati; per reti diverse serve un TURN raggiungibile.
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302"
# WEBRTC_TURN_URLS="turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349?transport=tcp"
# Segreto REST condiviso con coturn (use-auth-secret); mai pubblicarlo nel frontend.
# WEBRTC_TURN_SHARED_SECRET="<segreto-casuale-di-almeno-32-caratteri>"
CALL_RING_TIMEOUT_MS=30000
CALL_MAX_DURATION_MS=2700000

# Chiave stabile per la verifica in due passaggi; non condividere.
TOTP_ENCRYPTION_KEY=e9ef10dc7ccfcadde6c4442e3fc22bf2f3b94b67fabb41e634848813093c42b7

# LiveKit Cloud Build: inserisci i valori del tuo progetto.
